{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    // "node10" is deprecated in TS 6+ but valid in this project's TS 5.9.3.
    // VS Code may show a warning if its own TS version is newer — safe to ignore.
    // To fix properly in future: migrate to "module": "node16" + "moduleResolution": "node16"
    // and add .js extensions to all relative imports throughout src/.
    "moduleResolution": "node10"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
